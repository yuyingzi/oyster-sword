#!/usr/bin/env bash
set -euo pipefail

CODEX_DIR="${CODEX_HOME:-$HOME/.codex}"
PROFILE="$CODEX_DIR/deepseek.config.toml"
CATALOG_DIR="$CODEX_DIR/model-catalogs"
CATALOG="$CATALOG_DIR/deepseek.json"
DOC_SCRIPT_URL="https://cdn.deepseek.com/api-docs/codex-deepseek-setup-en.sh"
APP_CODEX="/Applications/ChatGPT.app/Contents/Resources/codex"
MANAGED_MARKER="# managed-by: codex-deepseek-profile"

codex_bin() {
  if [ -x "$APP_CODEX" ]; then
    printf '%s\n' "$APP_CODEX"
  else
    command -v codex || {
      printf 'Codex CLI was not found. Install Codex 0.144.0 or newer.\n' >&2
      exit 1
    }
  fi
}

check_version() {
  local version major minor
  version="$("$(codex_bin)" --version | sed -E 's/.* ([0-9]+)\.([0-9]+).*/\1.\2/')"
  major="${version%%.*}"
  minor="${version#*.}"
  if [ "$major" -eq 0 ] && [ "$minor" -lt 144 ]; then
    printf 'Codex %s is too old; DeepSeek requires 0.144.0 or newer.\n' "$version" >&2
    exit 1
  fi
}

install_profile() {
  local tmp_script tmp_catalog catalog_literal
  check_version
  if { [ -e "$PROFILE" ] && ! grep -qF "$MANAGED_MARKER" "$PROFILE"; } || \
     { [ -e "$CATALOG" ] && { [ ! -e "$PROFILE" ] || ! grep -qF "$MANAGED_MARKER" "$PROFILE"; }; }; then
    printf 'Refusing to overwrite an existing, unmanaged DeepSeek profile.\n' >&2
    exit 1
  fi
  mkdir -p "$CODEX_DIR" "$CATALOG_DIR"
  tmp_script="$(mktemp)"
  tmp_catalog="$(mktemp)"
  trap "rm -f '$tmp_script' '$tmp_catalog'" EXIT

  curl -fsSL "$DOC_SCRIPT_URL" -o "$tmp_script"
  awk '/^cat > "\$TMP_MODELS" <<'\''CODEX_MODELS_JSON'\''$/ {copy=1; next} copy && /^CODEX_MODELS_JSON$/ {exit} copy' "$tmp_script" > "$tmp_catalog"
  grep -q '"deepseek-v4-flash"' "$tmp_catalog" || {
    printf 'Could not extract the official DeepSeek model catalog.\n' >&2
    exit 1
  }
  command -v python3 >/dev/null || { printf 'python3 is required to validate the model catalog.\n' >&2; exit 1; }
  python3 - "$tmp_catalog" <<'PY'
import json
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as source:
    catalog = json.load(source)
catalog["models"] = [model for model in catalog["models"] if model.get("slug") == "deepseek-v4-flash"]
if len(catalog["models"]) != 1:
    raise SystemExit("official catalog did not contain exactly one deepseek-v4-flash entry")
old_identity = "You are Codex, an agent based on GPT-5."
new_identity = "You are Codex, running on DeepSeek-V4-Flash."
model = catalog["models"][0]
messages = model.get("model_messages", {})
identity_fields = (messages, "instructions_template"), (model, "base_instructions")
if any(old_identity not in container.get(key, "") for container, key in identity_fields):
    raise SystemExit("official catalog identity format changed; refusing to install without an accurate model identity")
for container, key in identity_fields:
    container[key] = container[key].replace(old_identity, new_identity)
with open(path, "w", encoding="utf-8") as target:
    json.dump(catalog, target, ensure_ascii=False, indent=2)
    target.write("\n")
PY
  catalog_literal="$(python3 -c 'import json, sys; print(json.dumps(sys.argv[1]))' "$CATALOG")"

  cp "$tmp_catalog" "$CATALOG"
  chmod 600 "$CATALOG"
  umask 077
  {
    printf '%s\n' "$MANAGED_MARKER"
    printf 'model = "deepseek-v4-flash"\n'
    printf 'model_provider = "deepseek"\n'
    printf 'model_reasoning_effort = "high"\n'
    printf 'model_catalog_json = %s\n\n' "$catalog_literal"
    printf '[model_providers.deepseek]\n'
    printf 'name = "DeepSeek"\n'
    printf 'base_url = "https://api.deepseek.com/"\n'
    printf 'wire_api = "responses"\n'
    printf 'env_key = "DEEPSEEK_API_KEY"\n'
  } > "$PROFILE"
  printf 'Installed %s\n' "$PROFILE"
  printf 'Set DEEPSEEK_API_KEY in your shell, then run: %s start\n' "$0"
}

status() {
  printf 'Codex: %s\n' "$("$(codex_bin)" --version)"
  if [ -f "$PROFILE" ] && [ -f "$CATALOG" ]; then
    printf 'Profile: installed\nModel: deepseek-v4-flash\n'
  else
    printf 'Profile: not installed\n'
  fi
  if [ -n "${DEEPSEEK_API_KEY:-}" ]; then
    printf 'API key: available in environment\n'
  else
    printf 'API key: missing (set DEEPSEEK_API_KEY)\n'
  fi
}

start() {
  check_version
  [ -f "$PROFILE" ] || { printf 'Run %s install first.\n' "$0" >&2; exit 1; }
  [ -n "${DEEPSEEK_API_KEY:-}" ] || { printf 'DEEPSEEK_API_KEY is not set.\n' >&2; exit 1; }
  exec "$(codex_bin)" --profile deepseek "$@"
}

run_exec() {
  check_version
  [ -f "$PROFILE" ] || { printf 'Run %s install first.\n' "$0" >&2; exit 1; }
  [ -n "${DEEPSEEK_API_KEY:-}" ] || { printf 'DEEPSEEK_API_KEY is not set.\n' >&2; exit 1; }
  exec "$(codex_bin)" exec --profile deepseek "$@"
}

uninstall_profile() {
  if [ -e "$PROFILE" ] && ! grep -qF "$MANAGED_MARKER" "$PROFILE"; then
    printf 'Refusing to remove an unmanaged DeepSeek profile.\n' >&2
    exit 1
  fi
  rm -f "$PROFILE" "$CATALOG"
  rmdir "$CATALOG_DIR" 2>/dev/null || true
  printf 'Removed the DeepSeek profile. The default OpenAI configuration was unchanged.\n'
}

case "${1:-status}" in
  install) install_profile ;;
  start) shift; start "$@" ;;
  exec) shift; run_exec "$@" ;;
  status) status ;;
  uninstall) uninstall_profile ;;
  *) printf 'Usage: %s {install|start|exec|status|uninstall}\n' "$0" >&2; exit 2 ;;
esac
